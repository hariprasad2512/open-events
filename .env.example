# ============================================================
# Startup Traction Intelligence
# Environment Configuration Template
#
# Copy this file to .env for local development:
#   cp .env.example .env
#
# Never commit the .env file.
# ============================================================

# ============================================================
# APPLICATION
# ============================================================
APP_ENV=development
APP_DEBUG=true

# Backend application URL
BACKEND_URL=http://localhost:8000

# Frontend application URL
FRONTEND_URL=http://localhost:3000

# API Host & Port for uvicorn runner
API_HOST=0.0.0.0
API_PORT=8000

# ============================================================
# BRIGHT DATA
# ============================================================
# Bright Data API token / authentication credential
BRIGHTDATA_API_TOKEN=
BRIGHT_DATA_API_KEY=

# Bright Data API base URL / zone / scraper ID
BRIGHTDATA_API_BASE_URL=
BRIGHT_DATA_ZONE=
BRIGHT_DATA_SCRAPER_ID=c_9f81a7b4

# Optional: default timeout in seconds for scraper operations
BRIGHTDATA_TIMEOUT_SECONDS=120

# Optional: polling interval when waiting for dataset completion
BRIGHTDATA_POLL_INTERVAL_SECONDS=5

# IMPORTANT:
# Do not place Collector IDs directly here unless they are
# environment-specific secrets.
# Approved collector metadata should be tracked in: configs/scraper_registry.json

# ============================================================
# DATABASE
# ============================================================
# Database connection string.
# Example local development value: sqlite:///backend/app/pipeline.db
DATABASE_URL=

# ============================================================
# SECURITY
# ============================================================
# Application secret. Generate a secure random value for local/production.
APP_SECRET_KEY=

# ============================================================
# CORS
# ============================================================
# Comma-separated allowed frontend origins.
CORS_ORIGINS=http://localhost:3000

# ============================================================
# OPTIONAL AI / AGENT SERVICES
# ============================================================
# Keep these empty unless a specific feature requires them.
GROQ_API_KEY=
GOOGLE_API_KEY=

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=INFO