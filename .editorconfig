# EditorConfig
# https://editorconfig.org

root = true


# ============================================================
# DEFAULT SETTINGS
# ============================================================

[*]

charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

indent_style = space
indent_size = 4


# ============================================================
# PYTHON
# ============================================================

[*.py]

indent_style = space
indent_size = 4


# ============================================================
# JAVASCRIPT / TYPESCRIPT
# ============================================================

[*.js]
indent_style = space
indent_size = 2

[*.jsx]
indent_style = space
indent_size = 2

[*.ts]
indent_style = space
indent_size = 2

[*.tsx]
indent_style = space
indent_size = 2


# ============================================================
# WEB / CONFIG FILES
# ============================================================

[*.json]
indent_style = space
indent_size = 2

[*.yml]
indent_style = space
indent_size = 2

[*.yaml]
indent_style = space
indent_size = 2

[*.toml]
indent_style = space
indent_size = 2


# ============================================================
# MARKDOWN
# ============================================================

[*.md]

trim_trailing_whitespace = false
indent_style = space
indent_size = 2


# ============================================================
# SHELL SCRIPTS
# ============================================================

[*.sh]

indent_style = space
indent_size = 2


# ============================================================
# MAKEFILES
# ============================================================

[Makefile]

indent_style = tab